# ---- Server ----
API_PORT=8787
# Public base URL that LINE and guests can reach. Locally: the Vite dev URL.
# When testing with real LINE, set this to your tunnel URL (e.g. https://xxxx.trycloudflare.com).
PUBLIC_URL=http://localhost:5173

# Leave empty to use the embedded database (PGlite) stored in apps/server/.data
# Set to a Postgres URL for staging/production, e.g. postgres://user:pass@host:5432/club
DATABASE_URL=

# development (default) or test locally. `npm start` sets NODE_ENV=production itself.
# NODE_ENV=development

# Long random string (at least 32 characters) used to sign links and media URLs.
# The server refuses to start while this is still the example value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Key that encrypts club credentials (LINE, Instagram, POS) at rest: base64 of 32 bytes.
# Required in production. In development and test it may stay empty: a key is then derived
# from APP_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# Shared Chatwoot CE inbox (infra/chatwoot/README.md). Leave empty to skip inbox provisioning:
# new clubs then get no Chatwoot account and the staff inbox link answers 503.
# CHATWOOT_PLATFORM_TOKEN is a Platform App token from Chatwoot's Super Admin console.
CHATWOOT_URL=
CHATWOOT_PLATFORM_TOKEN=

# Payment gateway option (A20b): Opn Payments (Omise). Leave unset to keep the PromptPay slip flow only.
# The webhook address to enter in Opn is <PUBLIC_URL>/webhooks/payments/opn. Each club also needs its
# payment_gateway switch on (founder console > Controls).
OPN_SECRET_KEY=
OPN_WEBHOOK_SECRET=

# Slip verification (B9, SlipOK). Leave empty: hosts approve every slip in the dashboard.
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# Claude API key for the bot brain. Optional until Phase 2.
ANTHROPIC_API_KEY=

# Staff and platform users sign in with their own email and password (no shared password).
# Create a platform admin:
#   npm run admin:create -w @club/server -- --email you@example.com --name "Your Name"
# Create a club user instead (e.g. an owner of the demo club):
#   npm run admin:create -w @club/server -- --email you@example.com --name "Your Name" --club demo --role owner
# Then sign in at http://localhost:5173/staff with that email and password.

# 1 = enable the local chat simulator at /dev/simulator.
# Only allowed when NODE_ENV is development or test; the server refuses to start otherwise.
DEV_SIMULATOR=1

# 1 = fake LINE: made-up channel credentials are accepted and every LINE setup step reports
# green, so the console wizard can be walked without a LINE account.
# Only allowed when NODE_ENV is development or test.
LINE_FAKE=

# ---- Demo club: "Velora (Demo)" ----
# Leave the LINE values empty to run with the simulator only.
DEMO_LINE_CHANNEL_SECRET=
DEMO_LINE_ACCESS_TOKEN=
DEMO_LIFF_ID=
# PromptPay phone or tax ID that deposits are paid TO. Use your own test account only.
# Empty = demo mode: no QR is generated and any image is accepted as a "slip" for review.
DEMO_PROMPTPAY_ID=

# ---- Going live on LINE (npm run live) ----
# LINE Login channel that owns the LIFF app. Lets the server verify guests' LINE identity on the
# booking form and update the LIFF endpoint automatically when the tunnel URL changes.
DEMO_LINE_LOGIN_CHANNEL_ID=
DEMO_LINE_LOGIN_CHANNEL_SECRET=
# `npm run live` signs in as an owner of the demo club. Create one first with
#   npm run admin:create -w @club/server -- --email <email> --name <name> --club demo --role owner
# and put the same email and password here.
LIVE_EMAIL=
LIVE_PASSWORD=
# Optional: your free ngrok static domain (e.g. something.ngrok-free.app) so the URL never changes.
NGROK_DOMAIN=

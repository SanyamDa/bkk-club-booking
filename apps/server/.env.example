# ---- Server ----
API_PORT=8787
# Public base URL that LINE and guests can reach. Locally: the Vite dev URL.
# When testing with real LINE, set this to your tunnel URL (e.g. https://xxxx.trycloudflare.com).
PUBLIC_URL=http://localhost:5173

# Leave empty to use the embedded database (PGlite) stored in apps/server/.data
# Set to a Postgres URL for staging/production, e.g. postgres://user:pass@host:5432/club
DATABASE_URL=

# Long random string used to sign links and media URLs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Password for the staff dashboard (Phase 0: one shared password)
STAFF_PASSWORD=change-me

# 1 = enable the local chat simulator at /dev/simulator (never enable in production)
DEV_SIMULATOR=1

# ---- Demo club: "Velour (Demo)" ----
# Leave the LINE values empty to run with the simulator only.
DEMO_LINE_CHANNEL_SECRET=
DEMO_LINE_ACCESS_TOKEN=
DEMO_LIFF_ID=
# PromptPay phone or tax ID that deposits are paid TO. Use your own test account only.
# Empty = demo mode: no QR is generated and any image is accepted as a "slip" for review.
DEMO_PROMPTPAY_ID=

# ---- Going live on LINE (npm run live) ----
# LINE Login channel that owns the LIFF app. Lets the server verify guests' LINE identity on the
# booking form and update the LIFF endpoint automatically when the tunnel URL changes.
DEMO_LINE_LOGIN_CHANNEL_ID=
DEMO_LINE_LOGIN_CHANNEL_SECRET=
# Optional: your free ngrok static domain (e.g. something.ngrok-free.app) so the URL never changes.
NGROK_DOMAIN=

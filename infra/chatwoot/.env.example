# Chatwoot CE settings (infra/chatwoot/README.md). Copy to .env and fill in.

# Public HTTPS address of the inbox, behind your reverse proxy.
FRONTEND_URL=https://inbox.example.com
# Long random string: openssl rand -hex 64
SECRET_KEY_BASE=
# Nobody signs up on their own: every account is made by our server.
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=en

POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 24
REDIS_PASSWORD=

# Outgoing mail (password resets, notifications). Optional at first.
MAILER_SENDER_EMAIL=Inbox <inbox@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
